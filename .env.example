# Copy to .env and fill in. .env is gitignored and must never be committed
# (hard rule 3). This file is documentation only — keep it valueless.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "anthropic", "openai", "bedrock", "ollama", or "custom".
# All calls route through common/llm.py; provider-specific behaviour must not
# leak outside it (see AGENTS.md § Architecture Direction).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Claude via Amazon Bedrock — the path for an AWS environment with no outbound
# access to api.anthropic.com. No API key: credentials come from the standard
# AWS chain, which on a deployed instance means the instance role, so nothing
# secret lands in this file. AWS_PROFILE is local development only.
# Note the `anthropic.` prefix on the model id — the bare first-party id 400s.
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-sonnet-5

# Local model via Ollama's OpenAI-compatible endpoint — no API key, no external
# network call. Requires `ollama serve` running with OLLAMA_MODEL pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Self-hosted / custom LLM — set LLM_PROVIDER=custom to use this block.
# ---------------------------------------------------------------------------
# This is the escape hatch for the locked-down sandbox: any OpenAI-compatible
# API — an internal gateway, vLLM, LiteLLM, TGI, LM Studio. Fill this in when
# the hosting team says "use our LLM". See CLAUDE.md § LLM access — open blocker.
#
# CUSTOM_LLM_BASE_URL must be the FULL endpoint root including the version
# segment, usually ending in /v1. It is used exactly as written — nothing is
# appended or rewritten, so a wrong URL gives a clean 404 rather than a
# confusing one. The client requests <CUSTOM_LLM_BASE_URL>/chat/completions.
#
# CUSTOM_LLM_API_KEY is optional — many self-hosted gateways do no auth.
#
# Examples:
#   CUSTOM_LLM_BASE_URL=https://llm.internal.example/v1
#   CUSTOM_LLM_BASE_URL=http://10.0.0.5:8000/v1        # vLLM default
#   CUSTOM_LLM_BASE_URL=http://localhost:1234/v1       # LM Studio default
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Determinism
# ---------------------------------------------------------------------------
# Two distinct stores, deliberately separate — do not point them at each other.
#
# LLM_CACHE_DIR is ephemeral spend-avoidance for live mode. It is gitignored and
# safe to delete at any time.
LLM_CACHE_DIR=.cache/llm
LLM_NO_CACHE=0

# LLM_REPLAY_DIR holds the COMMITTED replay recordings. These are a deliverable,
# not scratch: they are what lets a fresh clone with zero API keys run the whole
# demo offline (hard rule 5). They live under s7_delivery/cache/ precisely
# because that path is excluded from .gitignore while .cache/ is not.
LLM_REPLAY_DIR=s7_delivery/cache/llm

# "replay" is the demo-day default (hard rule 5: recorded outputs are primary,
# live calls are opt-in, never the reverse). "live" for ad hoc testing;
# "record" runs live AND refreshes the committed replay recordings.
LLM_MODE=replay

# Call telemetry (disk), for cost tracking.
LLM_TELEMETRY_PATH=.cache/llm/telemetry.jsonl

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# "local" runs fully offline after a one-time model download — no API key, and
# it cannot fail live on a network hiccup. "openai" reuses OPENAI_API_KEY above.
EMBEDDING_PROVIDER=local

# ---------------------------------------------------------------------------
# Jira — epic and user-story intake
# ---------------------------------------------------------------------------
# Writes must only ever fire from a human-confirmed action, never automatically.
# JIRA_MODE mirrors LLM_MODE: "live" calls the real API, "record" also saves a
# recording, "replay" reproduces it offline (demo-day default).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AMS
JIRA_MODE=replay
